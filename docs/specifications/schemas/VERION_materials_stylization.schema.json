{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VERION_materials_stylization",
  "description": "Stylization settings of a glTF material. Also required but not expressible here: toonRamp.thresholds strictly increasing, and palette length equal to thresholds length + 1.",
  "type": "object",
  "properties": {
    "hybridSurface": {
      "type": "object",
      "description": "Per-component blend between physical (0) and stylized (1).",
      "properties": {
        "diffuse": {
          "$ref": "#/$defs/unit"
        },
        "specular": {
          "$ref": "#/$defs/unit"
        },
        "gi": {
          "$ref": "#/$defs/unit"
        },
        "shadow": {
          "$ref": "#/$defs/unit"
        },
        "outline": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "toonRamp": {
      "type": "object",
      "properties": {
        "thresholds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          },
          "uniqueItems": true
        },
        "feather": {
          "$ref": "#/$defs/unit"
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "lightWrap": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "thresholds",
        "palette"
      ]
    },
    "shadowPalette": {
      "type": "object",
      "description": "Color grade of the shadowed part of the direct and indirect diffuse. Strength comes from hybridSurface.shadow.",
      "properties": {
        "direct": {
          "$ref": "#/$defs/colorAdjust"
        },
        "indirect": {
          "$ref": "#/$defs/colorAdjust"
        }
      }
    },
    "stylizedSpecular": {
      "type": "object",
      "description": "Per-light banded highlight that replaces the physical specular, blended by hybridSurface.specular. Non-physical.",
      "properties": {
        "shape": {
          "const": "band"
        },
        "size": {
          "$ref": "#/$defs/unit"
        },
        "feather": {
          "$ref": "#/$defs/unit"
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "ramp": {
          "$ref": "#/properties/toonRamp"
        }
      }
    },
    "outlineStyle": {
      "type": "object",
      "description": "Lines on silhouettes and creases, drawn in a post pass. Opacity comes from hybridSurface.outline. Non-physical.",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "depthThreshold": {
          "$ref": "#/$defs/unit"
        },
        "creaseAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        }
      }
    },
    "rimLight": {
      "type": "object",
      "description": "Non-physical rim added to the final color; independent of the light's strength.",
      "properties": {
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "width": {
          "$ref": "#/$defs/unit"
        },
        "feather": {
          "$ref": "#/$defs/unit"
        },
        "followLight": {
          "$ref": "#/$defs/unit"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "colorAdjust": {
      "type": "object",
      "properties": {
        "hueShift": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "saturation": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
